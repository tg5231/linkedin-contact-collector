{
  "manifest_version": 3,
  "name": "LinkedIn Contact Collector",
  "version": "0.1.0",
  "description": "Collect visible LinkedIn contact-info fields from connection overlay pages.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "LinkedIn Contact Collector",
    "default_popup": "options.html"
  },
  "options_page": "options.html"
}
